{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "categories-api",
      "urls": [
        "https://disti.site/api/market/categories"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "1d",
        "maxSize": 1
      }
    },
    {
      "name": "catalog-api",
      "urls": [
        "https://disti.site/api/market/shops**",
        "https://disti.site/api/market/shops/**",
        "https://disti.site/api/market/products**",
        "https://disti.site/api/market/products/**",
        "https://disti.site/api/market/reviews**",
        "https://disti.site/api/market/reviews/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "1d",
        "maxSize": 200
      }
    }
  ]
}
